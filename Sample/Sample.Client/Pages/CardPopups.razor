@page "/card-popups"

<div class="d-flex flex-column p-3" style="gap: 12px;">
    <FluentCard Height="auto">
        <h4>Popups inside a card</h4>
        <FluentStack>
            <FluentSelect TOption="string" Items="@items" Label="Select" @bind-Value="selectValue" />
            <FluentCombobox TOption="string" Items="@items" Label="Combobox" @bind-Value="comboValue" />
            <FluentAutocomplete TOption="string" Label="Autocomplete" OnOptionsSearch="Search" @bind-SelectedOptions="acValues" MaximumSelectedOptions="1" />
        </FluentStack>
    </FluentCard>
    <FluentCard Height="200px">
        <h4>Next card</h4>
        <p>Popups from the card above must render on top of this one.</p>
    </FluentCard>
</div>

@code {
    private readonly string[] items = Enumerable.Range(1, 30).Select(i => $"Item {i}").ToArray();
    private string? selectValue;
    private string? comboValue;
    private IEnumerable<string> acValues = [];

    private void Search(OptionsSearchEventArgs<string> e)
        => e.Items = items.Where(i => i.Contains(e.Text, StringComparison.OrdinalIgnoreCase));
}
