<Project>
  <PropertyGroup>
    <!--packages of projects-->
    <DotnetVersion8>8.0.23</DotnetVersion8>
    <DotnetVersion10>10.0.9</DotnetVersion10>
    <FluentVersion>4.14.2</FluentVersion>
    <LoggingVersion8>8.0.1</LoggingVersion8>
    <LoggingVersion10>8.0.1</LoggingVersion10>
    <SayehVersion>5.4.0.10</SayehVersion>
  </PropertyGroup>


  <ItemGroup>
    <PackageVersion Include="NetTopologySuite" Version="2.5.0" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="$(FluentVersion)" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="$(FluentVersion)" />
    <PackageVersion Include="Sayeh.AspNetCore.Essentials.Core" Version="$(SayehVersion)" />
    <PackageVersion Include="bunit" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(LoggingVersion8)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotnetVersion8)" />
    <PackageVersion  Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(DotnetVersion8)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotnetVersion10)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(LoggingVersion10)" />
    <PackageVersion  Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
    <PackageVersion  Include="Microsoft.Extensions.Localization" Version="$(DotnetVersion10)" />
    <PackageVersion  Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(DotnetVersion10)"/>
  </ItemGroup>
  
</Project>
