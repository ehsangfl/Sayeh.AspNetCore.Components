<Project>
  <PropertyGroup>
    <!--metadaata of assemblies-->
    <Authors>Ehsan Vali</Authors>
    <Company>Gooya Systems</Company>
    <Product>Sayeh</Product>

    <!--settings of projects-->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--local NuGet feed consumed by other solutions (e.g. SayehERP) via loose per-TFM folders-->
    <LocalPackagesRoot>E:\ThirdParties\LocalPackages</LocalPackagesRoot>

  </PropertyGroup>
</Project>
