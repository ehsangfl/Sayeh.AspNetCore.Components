<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>$(SayehVersion)</VersionPrefix>
    <Title>Sayeh.AspNetCore.Essentials.Blazor</Title>
    <Description>Some Services,Helpers DotNetCore Blazor platform</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
    <Authors>Ehsan Vali</Authors>
    <Product>Sayeh</Product>
    <PackageProjectUrl>https://apadanasystems.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ehsangfl/Sayeh.AspNetCore.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Asp.net  AspCore Blazor</PackageTags>
    <Company>Vira Pardazesh Apadana</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <ProjectReference Include="..\Sayeh.AspNetCore.Essentials.Core\Sayeh.AspNetCore.Essentials.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PackageReference Include="Sayeh.AspNetCore.Essentials.Core" />
  </ItemGroup>

  <Target Name="CopyToLocalPackagesFeed" AfterTargets="Build" Condition="'$(Configuration)'=='Debug' And '$(TargetFramework)'!=''">
    <ItemGroup>
      <_LocalFeedOutputFiles Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocalFeedOutputFiles)"
          DestinationFiles="@(_LocalFeedOutputFiles->'$(LocalPackagesRoot)\$(PackageId)\$(TargetFramework)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNupkgToLocalPackagesFeed" AfterTargets="Pack" Condition="'$(Configuration)'=='Debug'">
    <ItemGroup>
      <_LocalFeedNupkg Include="$(PackageOutputPath)$(PackageId).*.nupkg" />
    </ItemGroup>
    <Copy SourceFiles="@(_LocalFeedNupkg)"
          DestinationFolder="$(LocalPackagesRoot)\$(PackageId)\"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
